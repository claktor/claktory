# Claktory's browser on Mac (#435), the base image: Ubuntu, Google Chrome,
# Xvfb, fonts, Chrome's policy and the firewall, with no Claktory binary.
# Rebuilt when Chrome stable moves (scripts/browser-image.sh base); each
# release adds its runner on top (Containerfile). linux/arm64 only: Apple's
# container runs arm64 Linux.
ARG UBUNTU=docker.io/library/ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b

# Google's signing key, pinned by its fingerprint as
# https://www.google.com/linuxrepositories/ lists it (Fugo), exported alone.
FROM ${UBUNTU} AS key
ARG GOOGLE_FPR=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends ca-certificates curl gnupg >/dev/null \
 && export GNUPGHOME="$(mktemp -d)" \
 && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --quiet --import \
 && gpg --list-keys --with-colons "$GOOGLE_FPR" >/dev/null \
 && gpg --export "$GOOGLE_FPR" >/google-chrome.gpg

FROM ${UBUNTU}
ENV DEBIAN_FRONTEND=noninteractive
COPY --from=key /google-chrome.gpg /etc/apt/keyrings/google-chrome.gpg
RUN apt-get update -q && apt-get install -yq --no-install-recommends ca-certificates >/dev/null \
 && echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" >/etc/apt/sources.list.d/google-chrome.list \
 && apt-get update -q \
 && apt-get install -yq --no-install-recommends google-chrome-stable xvfb xauth nftables util-linux tzdata \
      fonts-liberation fonts-liberation2 fonts-dejavu-core fonts-noto-core fonts-noto-color-emoji fonts-noto-cjk >/dev/null \
 && rm -f /etc/apt/sources.list.d/google-chrome.* \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --home-dir /var/lib/claktory-browser --no-create-home --shell /usr/sbin/nologin claktory-browser \
 && install -d -m 0755 /etc/opt/chrome/policies/managed /opt/claktory-browser \
 && echo '{"LocalNetworkAccessRestrictionsEnabled": true, "LocalNetworkAccessBlockedForUrls": ["*"], "BrowserSignin": 0, "SyncDisabled": true, "CommandLineFlagSecurityWarningsEnabled": false}' >/etc/opt/chrome/policies/managed/claktory.json
COPY --chmod=0644 claktory-browser.nft /etc/claktory-browser.nft
COPY --chmod=0755 claktory-browser-nft.sh /usr/local/sbin/claktory-browser-nft
LABEL org.opencontainers.image.source=https://github.com/claktory/claktory \
      org.opencontainers.image.description="Claktory's agent browser (base: Chrome, Xvfb, fonts, policy, firewall)"
