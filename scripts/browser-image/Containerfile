# Claktory's browser on Mac (#435), one release's image: the base (its
# digest in base.txt) plus that release's runner, the linux-aarch64 static
# factoryd, and the entrypoint. Built by scripts/browser-image.sh release.
ARG BASE
FROM ${BASE}
ARG VERSION
# Safe Browsing's lists, fetched by this image's own Chrome as it's built:
# every new profile starts from them. SEED_AT is new each build, so the
# lists never come from a cached layer.
ARG SEED_AT
COPY --chmod=0755 seed.sh /usr/local/sbin/claktory-browser-seed
RUN echo "seed at $SEED_AT" && /usr/local/sbin/claktory-browser-seed && rm /usr/local/sbin/claktory-browser-seed
COPY --chmod=0755 runner /opt/claktory-browser/runner
COPY --chmod=0755 entry.sh /usr/local/sbin/claktory-browser-entry
LABEL org.opencontainers.image.source=https://github.com/claktory/claktory \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.description="Claktory's agent browser"
ENTRYPOINT ["/usr/local/sbin/claktory-browser-entry"]
