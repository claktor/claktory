# The toolchains a release of Claktory for the Mac builds with, in one place.
# scripts/check-toolchain.sh and scripts/lib.sh read them here; so does the
# build service (claktory-ops mac/build-user/setup.sh), which installs
# exactly these, read-only, for the commit it builds: Rust from Rust's own
# servers (its channel manifest pinned by SHA-256, every component checked
# against it), CMake from Kitware's GitHub releases (the macOS universal
# tarball, by SHA-256) and Flutter as a plain clone of flutter/flutter checked
# out at the revision. One NAME=value per line, nothing else on it.
#
# A new Rust means a new RUST_VERSION and RUST_CHANNEL_SHA256 here (the
# SHA-256 of https://static.rust-lang.org/dist/channel-rust-<version>.toml,
# its signature checked with Rust's release key) and the same channel in
# app/rust/rust-toolchain.toml. RUST_TARGETS are the standard libraries a
# release needs besides the Mac's own (the app is universal: arm64 and
# x86_64).
RUST_VERSION=1.97.1
RUST_CHANNEL_SHA256=03569b1886ceb5c05276b50c8431ab111de944cd6140fe1fa7d821dd8e0f29cf
RUST_TARGETS=aarch64-apple-darwin x86_64-apple-darwin
CMAKE_VERSION=4.5.1
CMAKE_SHA256=e1fb288543e4eb2a410e385ecebc64323bda51f0205782f2b094ccd5d572ca2d
FLUTTER_VERSION=3.50.0
FLUTTER_REVISION=ab2912035e160d9cad6306df307576da6128ebdb
