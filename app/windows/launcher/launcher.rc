// The launcher's icon (the Start menu shows it) and version: the app's own,
// by flavor (../runner/Runner.rc).
#pragma code_page(65001)
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#if CLAKTORY_FLAVOR_REAL
1 ICON "..\\runner\\resources\\app_icon.ico"
#else
1 ICON "..\\runner\\resources\\app_icon_dev.ico"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Claktory" "\0"
#if CLAKTORY_FLAVOR_REAL
            VALUE "FileDescription", "Claktory" "\0"
            VALUE "ProductName", "Claktory" "\0"
#else
            VALUE "FileDescription", "Claktory Dev" "\0"
            VALUE "ProductName", "Claktory Dev" "\0"
#endif
            VALUE "FileVersion", "1.0.0" "\0"
            VALUE "InternalName", "launcher" "\0"
            VALUE "OriginalFilename", "Claktory.exe" "\0"
            VALUE "ProductVersion", "1.0.0" "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
