// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The bundle's file name: Factory.app, where installs and updates find it.
// The name people see is CLAKTORY_NAME (Debug.xcconfig, Release.xcconfig).
PRODUCT_NAME = Factory

// The application's bundle identifier: the real Claktory's only in a Release
// build (Release.xcconfig); Debug and Profile builds get one of their own, so
// they can never stand in for the real Claktory in the Dock or Finder, nor
// read its Keychain item and user defaults (#501).
PRODUCT_BUNDLE_IDENTIFIER = $(CLAKTORY_BUNDLE_ID)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Claktory. All rights reserved.
