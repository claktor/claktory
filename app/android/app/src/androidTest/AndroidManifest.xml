<?xml version="1.0" encoding="utf-8"?>
<!-- The test APK only. androidx.test core 1.3.0 (the version the
     integration_test plugin pins for debug builds) predates Android 12's
     explicit android:exported, so it's said here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="androidx.test.core.app.InstrumentationActivityInvoker$BootstrapActivity"
            android:exported="false"
            tools:node="merge" />
        <activity
            android:name="androidx.test.core.app.InstrumentationActivityInvoker$EmptyActivity"
            android:exported="false"
            tools:node="merge" />
        <activity
            android:name="androidx.test.core.app.InstrumentationActivityInvoker$EmptyFloatingActivity"
            android:exported="false"
            tools:node="merge" />
        <!-- Another app's files, for SharedContentTest: the test APK is
             another package, so the app reads them across apps, as a
             share from Photos or Files. -->
        <provider
            android:name="com.claktory.app.ShareTestProvider"
            android:authorities="com.claktory.app.sharetest"
            android:exported="true"
            android:grantUriPermissions="true" />
        <!-- The same files, readable only through a share's grant, and the
             activity that shares them (SharedContentTest). -->
        <provider
            android:name="com.claktory.app.ShareSender$Private"
            android:authorities="com.claktory.app.sharetest.private"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name="com.claktory.app.ShareSender"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Another app a file share from Claktory goes to (ShareFilesTest). -->
        <activity
            android:name="com.claktory.app.ShareReceiver"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- tools/backup_exclusion_check.sh wakes its control with it. -->
        <receiver
            android:name="com.claktory.app.BackupControlWaker"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
